# Toss dashboard public-edge protection.
# HTTP → HTTPS redirect for /toss/ (session cookie + WebAuthn origin consistency)
#
# 접근 제어 변경 (2026-08-08):
#   - Basic Auth를 제거하고 toss_session 쿠키 기반 PHP 게이트로 일원화
#   - 각 PHP 파일(toss-auth.php, control.php, exclusion.php, auth-check.php)에서 쿠키 검증
#   - login.html만 공개

location = /toss {
    return 301 https://kwangho79.synology.me/toss/;
}

location ^~ /toss/ {
    if ($scheme = http) {
        return 301 https://kwangho79.synology.me$request_uri;
    }

    # 숨김 파일 차단
    location = /toss/.private { return 404; }
    location ^~ /toss/.private/ { return 404; }
    location = /toss/.control { return 404; }
    location ^~ /toss/.control/ { return 404; }
    location = /toss/.htaccess { return 404; }

    # toss-auth.php: Basic Auth 로그인은 PHP에서 처리
    location = /toss/toss-auth.php {
        fastcgi_pass unix:/var/run/php-fpm/php-95f7fe6c-5dbc-4f31-9c63-99ef91a6df1e.sock;
        fastcgi_param SCRIPT_FILENAME /var/services/web/toss/toss-auth.php;
        include fastcgi_params;
    }

    # logout.php
    location = /toss/logout.php {
        fastcgi_pass unix:/var/run/php-fpm/php-95f7fe6c-5dbc-4f31-9c63-99ef91a6df1e.sock;
        fastcgi_param SCRIPT_FILENAME /var/services/web/toss/logout.php;
        include fastcgi_params;
    }

    # login.html: 공개
    location = /toss/login.html {
        root /var/services/web;
    }

    # auth-check.php
    location = /toss/auth-check.php {
        fastcgi_pass unix:/var/run/php-fpm/php-95f7fe6c-5dbc-4f31-9c63-99ef91a6df1e.sock;
        fastcgi_param SCRIPT_FILENAME /var/services/web/toss/auth-check.php;
        include fastcgi_params;
    }

    # 그 외: Web Station 프록시 (control.php, exclusion.php, 정적 자산 등)
    proxy_ignore_headers X-Accel-Redirect;
    proxy_read_timeout 3600s;
    proxy_set_header X-Forwarded-By $server_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-HTTPS $https;
    proxy_set_header X-Port $server_port;
    proxy_set_header X-Real-Port $remote_port;
    proxy_set_header Host $http_host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_http_version 1.1;
    proxy_intercept_errors off;
    proxy_redirect http:// $scheme://;

    error_page 502 /_webstation_/$status.html;
    proxy_pass http://unix:/run/webstation_default.sock;
}
